#!/bin/sh
# Only ordinary UCI settings. Preserve the upstream board/radio definitions.
chmod 600 /etc/config/ruijie
uci -q set network.lan.ipaddr='192.168.5.1'
uci -q set system.@system[0].password='$1$acrh17$WFfNkXLpWCeyWtWOhxynD.'
uci -q set system.@system[0].hostname='DESKTOP-ACRH17'
uci -q set system.@system[0].zonename='Asia/Shanghai'
uci -q set system.@system[0].timezone='CST-8'
uci -q add_list system.ntp.server='ntp.aliyun.com'
uci -q add_list system.ntp.server='ntp.tencent.com'
uci -q add_list system.ntp.server='pool.ntp.org'
uci -q set luci.main.mediaurlbase='/luci-static/openwrt2020'
uci -q set dhcp.@dnsmasq[0].noresolv='1'
uci -q add_list dhcp.@dnsmasq[0].server='127.0.0.1#6053'
uci -q set smartdns.@smartdns[0].enabled='1'
uci -q set smartdns.@smartdns[0].port='6053'
uci -q set smartdns.@smartdns[0].auto_set_dnsmasq='1'
uci -q set smartdns.tencent_primary='server'
uci -q set smartdns.tencent_primary.enabled='1'
uci -q set smartdns.tencent_primary.type='udp'
uci -q set smartdns.tencent_primary.ip='119.29.29.29'
uci -q set smartdns.tencent_primary.port='53'
uci -q set smartdns.tencent_secondary='server'
uci -q set smartdns.tencent_secondary.enabled='1'
uci -q set smartdns.tencent_secondary.type='udp'
uci -q set smartdns.tencent_secondary.ip='119.28.28.28'
uci -q set smartdns.tencent_secondary.port='53'
uci -q set smartdns.aliyun_primary='server'
uci -q set smartdns.aliyun_primary.enabled='1'
uci -q set smartdns.aliyun_primary.type='udp'
uci -q set smartdns.aliyun_primary.ip='223.5.5.5'
uci -q set smartdns.aliyun_primary.port='53'
uci -q set smartdns.aliyun_secondary='server'
uci -q set smartdns.aliyun_secondary.enabled='1'
uci -q set smartdns.aliyun_secondary.type='udp'
uci -q set smartdns.aliyun_secondary.ip='223.6.6.6'
uci -q set smartdns.aliyun_secondary.port='53'
uci -q set ua3f.enabled.enabled='1'
uci -q commit network
uci -q commit system
uci -q commit luci
uci -q commit dhcp
uci -q commit smartdns
uci -q commit ua3f
/etc/init.d/smartdns enable
/etc/init.d/smartdns start
/etc/init.d/ua3f enable
/etc/init.d/ua3f start

for radio in $(uci show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.=]*\)=wifi-device$/\1/p"); do
	uci -q set wireless."$radio".country="$(uci -q get acrh17.settings.wifi_country || echo CN)"
done
uci -q commit wireless
uci -q set system.@system[0].zram_size_mb='64'
# Services become active once their real uplinks / printer are configured in LuCI.
uci -q set mwan3.globals.mmx_mask='0x3f000000'
uci -q commit mwan3
/etc/init.d/mwan3 disable
uci -q set p910nd.@p910nd[0].enabled='0'
uci -q commit p910nd
/etc/init.d/watchcat disable
/etc/init.d/ddns disable
/etc/init.d/sqm disable
uci -q set irqbalance.irqbalance.enabled='1'
uci -q commit irqbalance
/etc/init.d/irqbalance enable
/etc/init.d/irqbalance start

# Commands remain short and read the USB WAN logical interface from UCI.
uci -q add luci command
uci -q set luci.@command[-1].name='重新认证锐捷'
uci -q set luci.@command[-1].command='/usr/libexec/ruijie-auth reauth'
uci -q add luci command
uci -q set luci.@command[-1].name='重启 UA3F'
uci -q set luci.@command[-1].command='/etc/init.d/ua3f restart'
uci -q add luci command
uci -q set luci.@command[-1].name='重拨 USB WAN'
uci -q set luci.@command[-1].command='/usr/libexec/acrh17-usbwan-redial'
uci -q add luci command
uci -q set luci.@command[-1].name='重启打印服务'
uci -q set luci.@command[-1].command='/etc/init.d/p910nd restart'
uci -q add luci command
uci -q set luci.@command[-1].name='查看 USB 设备'
uci -q set luci.@command[-1].command='lsusb'
uci -q add luci command
uci -q set luci.@command[-1].name='查看 USB 网络驱动状态'
uci -q set luci.@command[-1].command='/usr/libexec/acrh17-usb-net-status'
uci -q commit luci
exit 0
