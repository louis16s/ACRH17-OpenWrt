#!/bin/sh
# Only ordinary UCI settings. Preserve the upstream board/radio definitions.
chmod 600 /etc/config/ruijie
uci -q set network.lan.ipaddr='192.168.5.1'
# IPv4-only operation: stop WAN6 and prevent LAN RA/DHCPv6 advertisements.
uci -q set network.lan.ip6assign='0'
if uci -q show network.wan6 >/dev/null 2>&1; then
	uci -q set network.wan6.proto='none'
	uci -q set network.wan6.auto='0'
fi
uci -q set dhcp.lan.dhcpv6='disabled'
uci -q set dhcp.lan.ra='disabled'
uci -q set dhcp.lan.ndp='disabled'
uci -q set dhcp.lan.ra_flags='none'
uci -q set firewall.@defaults[0].disable_ipv6='1'
printf '%s\n%s\n' password password | passwd root
uci -q set system.@system[0].hostname='DESKTOP-ACRH17'
uci -q set system.@system[0].zonename='Asia/Shanghai'
uci -q set system.@system[0].timezone='CST-8'
uci -q add_list system.ntp.server='ntp.aliyun.com'
uci -q add_list system.ntp.server='ntp.tencent.com'
uci -q add_list system.ntp.server='pool.ntp.org'
uci -q set luci.main.mediaurlbase='/luci-static/argon'
uci -q set dhcp.@dnsmasq[0].noresolv='1'
uci -q set dhcp.@dnsmasq[0].strictorder='1'
uci -q delete dhcp.@dnsmasq[0].server
# Prefer SmartDNS while healthy, but retain direct IPv4 fallbacks for boot and
# captive-portal recovery when SmartDNS is stopped or not yet reachable.
uci -q add_list dhcp.@dnsmasq[0].server='127.0.0.1#6053'
uci -q add_list dhcp.@dnsmasq[0].server='223.5.5.5'
uci -q add_list dhcp.@dnsmasq[0].server='119.29.29.29'
uci -q add_list dhcp.@dnsmasq[0].server='114.114.114.114'
uci -q set smartdns.@smartdns[0].enabled='1'
uci -q set smartdns.@smartdns[0].port='6053'
uci -q set smartdns.@smartdns[0].auto_set_dnsmasq='0'
# Keep the resolver IPv4-only together with the rest of this image.
uci -q set smartdns.@smartdns[0].ipv6_server='0'
uci -q set smartdns.@smartdns[0].dualstack_ip_selection='0'
uci -q set smartdns.tencent_primary='server'
uci -q set smartdns.tencent_primary.enabled='1'
uci -q set smartdns.tencent_primary.type='udp'
uci -q set smartdns.tencent_primary.ip='119.29.29.29'
uci -q set smartdns.tencent_primary.port='53'
uci -q set smartdns.tencent_secondary='server'
uci -q set smartdns.tencent_secondary.enabled='1'
uci -q set smartdns.tencent_secondary.type='udp'
uci -q set smartdns.tencent_secondary.ip='119.28.28.28'
uci -q set smartdns.tencent_secondary.port='53'
uci -q set smartdns.aliyun_primary='server'
uci -q set smartdns.aliyun_primary.enabled='1'
uci -q set smartdns.aliyun_primary.type='udp'
uci -q set smartdns.aliyun_primary.ip='223.5.5.5'
uci -q set smartdns.aliyun_primary.port='53'
uci -q set smartdns.aliyun_secondary='server'
uci -q set smartdns.aliyun_secondary.enabled='1'
uci -q set smartdns.aliyun_secondary.type='udp'
uci -q set smartdns.aliyun_secondary.ip='223.6.6.6'
uci -q set smartdns.aliyun_secondary.port='53'
uci -q set ua3f.enabled.enabled='1'
uci -q commit network
uci -q commit system
uci -q commit luci
uci -q commit dhcp
uci -q commit firewall
uci -q commit smartdns
uci -q commit ua3f
/etc/init.d/smartdns enable
/etc/init.d/smartdns start
# Reload dnsmasq after SmartDNS is listening so it picks up the local resolver
# and keeps the direct IPv4 servers as a runtime fallback.
/etc/init.d/dnsmasq restart
/etc/init.d/firewall reload
/etc/init.d/ua3f enable
/etc/init.d/ua3f start

for radio in $(uci show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.=]*\)=wifi-device$/\1/p"); do
	uci -q set wireless."$radio".country="$(uci -q get acrh17.settings.wifi_country || echo AU)"
	uci -q set wireless."$radio".disabled='0'
done
for iface in $(uci show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.=]*\)=wifi-iface$/\1/p"); do
	radio="$(uci -q get wireless."$iface".device)"
	band="$(uci -q get wireless."$radio".band)"
	uci -q set wireless."$iface".disabled='0'
	uci -q set wireless."$iface".encryption='psk2'
	uci -q set wireless."$iface".key='password'
	case "$band" in
		2g) uci -q set wireless."$iface".ssid='ACRH17-2.4G' ;;
		5g) uci -q set wireless."$iface".ssid='ACRH17-5G' ;;
	esac
done
uci -q commit wireless
uci -q set argon.main=global
uci -q set argon.main.mode=dark
uci -q set argon.main.primary="#5e72e4"
uci -q set argon.main.dark_primary="#483d8b"
uci -q set argon.main.blur=10
uci -q set argon.main.blur_dark=10
uci -q set argon.main.transparency=0.5
uci -q set argon.main.transparency_dark=0.5
uci -q commit argon
uci -q set system.@system[0].zram_size_mb='64'
uci -q commit system
# Services become active once their real uplinks / printer are configured in LuCI.
if [ -x /etc/init.d/mwan3 ]; then
uci -q set mwan3.globals.mmx_mask='0x3f000000'
for msection in $(uci -q get acrh17.settings.mwan3_interface); do
	# Only touch sections that already exist in the package/user mwan3 config.
	# This leaves wan2/usbwan ready for LuCI without inventing a WAN.
	if ! uci -q show mwan3."$msection" >/dev/null 2>&1; then
		continue
	fi
	family="$(uci -q get mwan3."$msection".family)"
	[ "$family" = ipv6 ] && continue
	uci -q delete mwan3."$msection".track_ip
	for target in $(uci -q get acrh17.settings.mwan3_probe_ip); do
		uci -q add_list mwan3."$msection".track_ip="$target"
	done
	uci -q set mwan3."$msection".family='ipv4'
	uci -q set mwan3."$msection".reliability='2'
	uci -q set mwan3."$msection".timeout='2'
	uci -q set mwan3."$msection".interval='5'
	uci -q set mwan3."$msection".down='3'
	uci -q set mwan3."$msection".up='3'
done
for msection in wan6 wanb6; do
	uci -q set mwan3."$msection".enabled='0'
done
uci -q commit mwan3
/etc/init.d/mwan3 disable
fi
uci -q set p910nd.@p910nd[0].enabled='0'
uci -q commit p910nd
/etc/init.d/watchcat disable
/etc/init.d/ddns disable
uci -q set irqbalance.irqbalance.enabled='1'
uci -q commit irqbalance
/etc/init.d/irqbalance enable
/etc/init.d/irqbalance start
uci -q set turboacc.config.sw_flow='0'
uci -q set turboacc.config.hw_flow='0'
uci -q set turboacc.config.sfe_flow='0'
uci -q set turboacc.config.fullcone_nat='0'
uci -q set turboacc.config.bbr_cca='1'
uci -q commit turboacc
/etc/init.d/turboacc enable
/etc/init.d/turboacc start

# Commands remain short and read the USB WAN logical interface from UCI.
uci -q add luci command
uci -q set luci.@command[-1].name='重新认证锐捷'
uci -q set luci.@command[-1].command='/usr/libexec/ruijie-auth reauth'
uci -q add luci command
uci -q set luci.@command[-1].name='重启 UA3F'
uci -q set luci.@command[-1].command='/etc/init.d/ua3f restart'
uci -q add luci command
uci -q set luci.@command[-1].name='重拨 USB WAN'
uci -q set luci.@command[-1].command='/usr/libexec/acrh17-usbwan-redial'
uci -q add luci command
uci -q set luci.@command[-1].name='重启打印服务'
uci -q set luci.@command[-1].command='/etc/init.d/p910nd restart'
uci -q add luci command
uci -q set luci.@command[-1].name='查看 USB 设备'
uci -q set luci.@command[-1].command='lsusb'
uci -q add luci command
uci -q set luci.@command[-1].name='查看 USB 网络驱动状态'
uci -q set luci.@command[-1].command='/usr/libexec/acrh17-usb-net-status'
uci -q commit luci
exit 0
