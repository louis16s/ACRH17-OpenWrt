#!/bin/sh /etc/rc.common
USE_PROCD=1
START=95
STOP=10

start_service() {
	local enabled
	enabled="$(uci -q get ruijie.main.enabled)"
	[ "$enabled" = "1" ] || return 0

	procd_open_instance
	procd_set_param command /usr/libexec/ruijie-auth daemon
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger ruijie
}
