#!/bin/sh
# Credentials stay in a root-readable UCI file; responses stay in tmpfs.
umask 077
CFG="ruijie.main"
LAST="/tmp/ruijie-auth.last"
get() { uci -q get "$CFG.$1"; }

request() {
	DEVICE="$(get interface)"
	[ -z "$DEVICE" ] || set -- --interface "$DEVICE" "$@"
	[ -z "$COOKIE" ] || set -- -H "Cookie: $COOKIE" "$@"
	[ -z "$REFERER" ] || set -- --referer "$REFERER" "$@"
	[ -z "$SERVER" ] || set -- -H "Origin: $SERVER" "$@"
	curl -fsS --noproxy '*' --proto '=http,https' --connect-timeout 5 --max-time 15 \
		-H 'User-Agent: Mozilla/5.0' \
		-H 'Content-Type: application/x-www-form-urlencoded; charset=UTF-8' "$@"
}

status() {
	CHECK_URL="$(get check_url)"
	[ -n "$CHECK_URL" ] || CHECK_URL="http://connect.rom.miui.com/generate_204"
	# No redirect following. A captive portal's 200/302 is not Internet access.
	CODE="$(request -o /dev/null -w '%{http_code}' "$CHECK_URL" 2>/dev/null)" &&
		[ "$CODE" = '204' ] && { echo online; return 0; }
	echo offline
	return 1
}

portal() {
	ACTION="$1"
	SERVER="$(get server)"
	PORTAL_PATH="$(get "${ACTION}_path")"
	COOKIE="$(get cookie)"
	REFERER="$(get referer)"
	QUERY="$(get query_string)"
	case "$SERVER" in http://?*|https://?*) ;; *) echo 'ERROR: HTTP(S) server required'; return 1;; esac
	case "$PORTAL_PATH" in /*) ;; *) echo 'ERROR: portal path must begin with /'; return 1;; esac
	set -- --data-urlencode "queryString=$QUERY"
	if [ "$ACTION" = login ]; then
		USERNAME="$(get username)"
		[ -n "$USERNAME" ] || { echo 'ERROR: userId required'; return 1; }
		set -- "$@" \
			--data-urlencode "userId=$USERNAME" \
			--data-urlencode "password=$(get password_payload)" \
			--data-urlencode "service=$(get service)" \
			--data-urlencode "operatorPwd=$(get operator_pwd)" \
			--data-urlencode "operatorUserId=$(get operator_user_id)" \
			--data-urlencode "validcode=$(get validcode)" \
			--data-urlencode "passwordEncrypt=$(get password_encrypt)"
	fi
	RESPONSE="$(mktemp /tmp/ruijie-auth.response.XXXXXX)" || return 1
	# Bounded response and atomic status update; never send portal payloads to syslog.
	if request --max-filesize 65536 -o "$RESPONSE" "$@" "${SERVER%/}$PORTAL_PATH" 2>/dev/null; then
		RESULT="$(jsonfilter -i "$RESPONSE" -e '@.result' 2>/dev/null)"
		if [ "$RESULT" = success ]; then
			RC=0
			printf '%s: portal reported success\n' "$ACTION" > "$RESPONSE"
		else
			RC=1
			printf '%s: portal rejected request or returned an unrecognized response\n' "$ACTION" > "$RESPONSE"
		fi
	else
		RC=1
		printf '%s: HTTP or network error\n' "$ACTION" > "$RESPONSE"
	fi
	mv -f "$RESPONSE" "$LAST"
	cat "$LAST"
	logger -t ruijie-auth "$ACTION rc=$RC"
	return "$RC"
}

daemon() {
	INTERVAL="$(get check_interval)"
	case "$INTERVAL" in ''|*[!0-9]*) INTERVAL=60;; esac
	[ "$INTERVAL" -ge 15 ] 2>/dev/null && [ "$INTERVAL" -le 3600 ] 2>/dev/null || INTERVAL=60
	while true; do
		if ! status >/dev/null 2>&1; then
			portal login >/dev/null 2>&1
		fi
		# Do not attach authentication headers to the next connectivity probe.
		SERVER= COOKIE= REFERER=
		sleep "$INTERVAL"
	done
}

case "$1" in
	login|logout) portal "$1";;
	status) status;;
	daemon) daemon;;
	*) echo "Usage: $0 {login|logout|status|daemon}"; exit 1;;
esac
