#!/bin/sh
# Credentials stay in a root-readable UCI file; responses stay in tmpfs.
umask 077
CFG="ruijie.main"
LAST="/tmp/ruijie-auth.last"
STATE="/tmp/ruijie-auth.state"
get() { uci -q get "$CFG.$1"; }

number() {
	case "$1" in ''|*[!0-9]*) printf '%s' "$2";; *) printf '%s' "$1";; esac
}

wan_ready() {
	wan="$(get wan_interface)"
	case "$wan" in ''|*[!A-Za-z0-9_-]*) wan=wan;; esac
	status_json="$(ubus call "network.interface.$wan" status 2>/dev/null)" || return 1
	up="$(printf '%s' "$status_json" | jsonfilter -e '@.up' 2>/dev/null)"
	case "$up" in 1|true) ;; *) return 1;; esac
	ipv4="$(printf '%s' "$status_json" | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)"
	case "$ipv4" in ''|0.0.0.0) return 1;; esac
	return 0
}

save_state() {
	state="$1"
	result="$2"
	summary="$(printf '%s' "$3" | tr '\n' ' ' | cut -c1-240)"
	tmp="${STATE}.tmp.$$"
	{
		printf 'auth_state=%s\n' "$state"
		printf 'last_result=%s\n' "$result"
		printf 'last_time=%s\n' "$(date '+%Y-%m-%d %H:%M:%S')"
		printf 'last_summary=%s\n' "$summary"
	} > "$tmp" && mv -f "$tmp" "$STATE"
}

request() {
	DEVICE="$(get interface)"
	[ -z "$DEVICE" ] || set -- --interface "$DEVICE" "$@"
	[ -z "$COOKIE" ] || set -- -H "Cookie: $COOKIE" "$@"
	[ -z "$REFERER" ] || set -- --referer "$REFERER" "$@"
	[ -z "$SERVER" ] || set -- -H "Origin: $SERVER" "$@"
	curl -fsS --noproxy '*' --proto '=http,https' --connect-timeout 5 --max-time 15 \
		-H 'User-Agent: Mozilla/5.0' \
		-H 'Content-Type: application/x-www-form-urlencoded; charset=UTF-8' "$@"
}

status() {
	SERVER= COOKIE= REFERER=
	# A captive portal check is only useful after the logical WAN is up and
	# has an IPv4 lease. This avoids a 15s probe followed by another 15s login
	# request while DHCP is still down.
	wan_ready || { echo offline; return 1; }
	CHECK_URL="$(get check_url)"
	[ -n "$CHECK_URL" ] || CHECK_URL="http://connect.rom.miui.com/generate_204"
	# No redirect following. A captive portal's 200/302 is not Internet access.
	CODE="$(request -o /dev/null -w '%{http_code}' "$CHECK_URL" 2>/dev/null)" &&
		[ "$CODE" = '204' ] && { echo online; return 0; }
	echo offline
	return 1
}

portal() {
	ACTION="$1"
	if ! wan_ready; then
		save_state authenticating pending 'WAN is not ready; waiting for IPv4 before portal request'
		echo 'ERROR: WAN is not up or has no IPv4 address'
		return 1
	fi
	SERVER="$(get server)"
	PORTAL_PATH="$(get "${ACTION}_path")"
	COOKIE="$(get cookie)"
	REFERER="$(get referer)"
	QUERY="$(get query_string)"
	case "$SERVER" in http://?*|https://?*) ;; *) echo 'ERROR: HTTP(S) server required'; return 1;; esac
	case "$PORTAL_PATH" in /*) ;; *) echo 'ERROR: portal path must begin with /'; return 1;; esac
	set -- --data-urlencode "queryString=$QUERY"
	if [ "$ACTION" = login ]; then
		USERNAME="$(get username)"
		[ -n "$USERNAME" ] || { echo 'ERROR: userId required'; return 1; }
		set -- "$@" \
			--data-urlencode "userId=$USERNAME" \
			--data-urlencode "password=$(get password_payload)" \
			--data-urlencode "service=$(get service)" \
			--data-urlencode "operatorPwd=$(get operator_pwd)" \
			--data-urlencode "operatorUserId=$(get operator_user_id)" \
			--data-urlencode "validcode=$(get validcode)" \
			--data-urlencode "passwordEncrypt=$(get password_encrypt)"
	fi
	RESPONSE="$(mktemp /tmp/ruijie-auth.response.XXXXXX)" || return 1
	# Bounded response and atomic status update; never send portal payloads to syslog.
	if request --max-filesize 65536 -o "$RESPONSE" "$@" "${SERVER%/}$PORTAL_PATH" 2>/dev/null; then
		RESULT="$(jsonfilter -i "$RESPONSE" -e '@.result' 2>/dev/null)"
		if [ "$RESULT" = success ]; then
			RC=0
			printf '%s: portal reported success\n' "$ACTION" > "$RESPONSE"
		else
			RC=1
			printf '%s: portal rejected request or returned an unrecognized response\n' "$ACTION" > "$RESPONSE"
		fi
	else
		RC=1
		printf '%s: HTTP or network error\n' "$ACTION" > "$RESPONSE"
	fi
	mv -f "$RESPONSE" "$LAST"
	if [ "$RC" = 0 ]; then
		if [ "$ACTION" = logout ]; then
            save_state offline success "$(cat "$LAST")"
        elif status >/dev/null 2>&1; then
            save_state online success "$(cat "$LAST")"
        else
            save_state offline success "Portal accepted login; Internet probe has not succeeded"
        fi
	else
		save_state failed failure "$(cat "$LAST")"
	fi
	cat "$LAST"
	logger -t ruijie-auth "$ACTION rc=$RC"
	return "$RC"
}

renew_wan() {
	wan="$(get wan_interface)"
	[ -n "$wan" ] || wan=wan
	if ifdown "$wan" >/dev/null 2>&1 && sleep 2 && ifup "$wan" >/dev/null 2>&1; then
		save_state authenticating pending "WAN DHCP renewed on $wan"
		logger -t ruijie-auth "wan-renew interface=$wan rc=0"
		return 0
	fi
	save_state failed failure "WAN DHCP renew failed on $wan"
	logger -t ruijie-auth "wan-renew interface=$wan rc=1"
	return 1
}

reauth() {
	save_state authenticating pending 'Reauthentication requested'
	portal logout >/dev/null 2>&1 || true
	sleep 2
	[ "$(get renew_dhcp_on_reauth)" = 1 ] && renew_wan || true
	portal login
}

clear_results() {
	rm -f "$LAST" "$STATE"
	logger -t ruijie-auth 'cleared recent authentication results'
	echo 'recent authentication results cleared'
}

daemon() {
	INTERVAL="$(number "$(get check_interval)" 60)"
	RETRY="$(number "$(get retry_interval)" 30)"
	MAX_FAILURES="$(number "$(get max_failures)" 3)"
	[ "$INTERVAL" -ge 15 ] 2>/dev/null && [ "$INTERVAL" -le 3600 ] 2>/dev/null || INTERVAL=60
	[ "$RETRY" -ge 10 ] 2>/dev/null && [ "$RETRY" -le 3600 ] 2>/dev/null || RETRY=30
	[ "$MAX_FAILURES" -ge 1 ] 2>/dev/null && [ "$MAX_FAILURES" -le 99 ] 2>/dev/null || MAX_FAILURES=3
	FAILURES=0
	if [ "$(get boot_login)" = 1 ]; then
		if wan_ready; then
			save_state authenticating pending 'Boot authentication requested'
			portal login >/dev/null 2>&1 || true
		else
			save_state authenticating pending 'WAN is not ready; waiting for IPv4 before boot authentication'
		fi
	fi
	while true; do
		if [ "$(get auto_reconnect)" != 1 ]; then
			sleep "$INTERVAL"
			continue
		fi
		# Do this before status() so DHCP-down periods do not incur two curl
		# timeouts (connectivity probe plus portal login).
		if ! wan_ready; then
			save_state authenticating pending 'WAN is not ready; waiting for IPv4'
			FAILURES=0
			sleep "$RETRY"
			continue
		fi
		if status >/dev/null 2>&1; then
			FAILURES=0
		else
			save_state authenticating pending 'Connectivity check failed; authenticating'
			if portal login >/dev/null 2>&1; then
				FAILURES=0
			else
				FAILURES=$((FAILURES + 1))
				if [ "$FAILURES" -ge "$MAX_FAILURES" ]; then
					case "$(get failure_action)" in
						restart_wan) renew_wan || true;;
						restart_service) /etc/init.d/ruijie-auth restart >/dev/null 2>&1 || true;;
						retry) :;;
					esac
					# Keep the retry action at the capped delay. Recovery actions
					# start a fresh backoff after they have been attempted.
					[ "$(get failure_action)" = retry ] || FAILURES=0
				fi
			fi
		fi
		# Do not attach authentication headers to the next connectivity probe.
		SERVER= COOKIE= REFERER=
		if [ "$FAILURES" -gt 0 ]; then
			# With the default retry_interval=30 this is 30s, 45s, 60s,
			# then 60s for subsequent failures. The value remains tunable.
			case "$FAILURES" in
				1) DELAY="$RETRY";;
				2) DELAY=$((RETRY + (RETRY + 1) / 2));;
				*) DELAY=$((RETRY * 2));;
			esac
			[ "$DELAY" -le 60 ] 2>/dev/null || DELAY=60
		else
			DELAY="$INTERVAL"
		fi
		sleep "$DELAY"
	done
}

case "$1" in
	login|logout) portal "$1";;
	status) status;;
	reauth) reauth;;
	renew-wan) renew_wan;;
	clear) clear_results;;
	daemon) daemon;;
	*) echo "Usage: $0 {login|logout|reauth|renew-wan|clear|status|daemon}"; exit 1;;
esac
