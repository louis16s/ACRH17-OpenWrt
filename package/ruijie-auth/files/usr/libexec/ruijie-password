#!/bin/sh
# Change the Ruijie account password with a one-command rollback.
#
# A wrong password takes the campus link down and the daemon cannot recover by
# retrying, so every change keeps the value it replaced in password_prev and
# the replacement is proven by a real portal round trip before it is kept.
# When that round trip is rejected the old password goes back automatically.
#
#   ruijie-password status            what is stored, masked
#   ruijie-password set <password>    back up, switch, verify, auto-revert
#   ruijie-password set <password> --no-test
#   ruijie-password check             verify the current password with a login
#   ruijie-password revert            put the backed-up password back
#   ruijie-password drop              discard the rollback point
#
# Passwords never reach syslog; only the fact that one changed does.
umask 077
CFG="ruijie.main"
LAST="/tmp/ruijie-auth.last"
get() { uci -q get "$CFG.$1"; }

# Enough to tell two known passwords apart in a terminal without printing one.
mask() {
	[ -n "$1" ] || { printf '(未设置)'; return; }
	printf '%s 位，末两位 %s' "${#1}" "$(printf '%s' "$1" | tail -c 2)"
}

wan_ready() {
	wan="$(get wan_interface)"
	case "$wan" in ''|*[!A-Za-z0-9_-]*) wan=wan;; esac
	status_json="$(ubus call "network.interface.$wan" status 2>/dev/null)" || return 1
	up="$(printf '%s' "$status_json" | jsonfilter -e '@.up' 2>/dev/null)"
	case "$up" in 1|true) ;; *) return 1;; esac
	ipv4="$(printf '%s' "$status_json" | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)"
	case "$ipv4" in ''|0.0.0.0) return 1;; esac
	return 0
}

daemon_was_running=0

# The daemon re-authenticates on its own schedule and takes the authentication
# lock while it does. Left running it would race the probe, turning a busy lock
# into a "75" that says nothing about the password. Stop it for the round trip
# and start it again once the winning password is the one in the config.
pause_daemon() {
	daemon_was_running=0
	if /etc/init.d/ruijie-auth running >/dev/null 2>&1; then
		daemon_was_running=1
		/etc/init.d/ruijie-auth stop >/dev/null 2>&1
	fi
}

resume_daemon() {
	[ "$daemon_was_running" = 1 ] && /etc/init.d/ruijie-auth start >/dev/null 2>&1
	return 0
}

# Why the last portal round trip ended the way it did. A request that never
# reached the portal says nothing about the password, so it must not be read as
# "the password is wrong" -- that would roll back a good password during a
# transient outage. The portal's rejection message is the only other outcome,
# and it is ambiguous: usually a bad credential, occasionally a portal hiccup.
last_reason() {
	reason="$(cat "$LAST" 2>/dev/null)"
	case "$reason" in
	login:*'HTTP or network error'*) printf 'network';;
	login:*) printf 'rejected';;
	*) printf 'unknown';;
	esac
}

explain_failure() {
	case "$1" in
	network)
		echo '认证请求没能送达门户（网络问题），这不代表新密码是错的。'
		echo '要立刻退回旧密码: /usr/libexec/ruijie-password revert'
		;;
	rejected)
		echo '门户拒绝了这次登录，最可能是密码不对。'
		;;
	*)
		echo "未能确认登录结果，详情见 $LAST。"
		;;
	esac
}

CMD="${1:-}"
[ $# -gt 0 ] && shift

case "$CMD" in
status)
	cur="$(get password_payload)"
	prev="$(get password_prev)"
	printf '当前密码 : %s\n' "$(mask "$cur")"
	printf '回退点   : %s\n' "$(mask "$prev")"
	if [ -n "$prev" ]; then
		echo '可用 /usr/libexec/ruijie-password revert 换回回退点里的那个'
	else
		echo '没有回退点：保存新密码时会自动把旧密码存进去'
	fi
	;;

set)
	NEW="${1:-}"
	[ $# -gt 0 ] && shift
	TEST=1
	case "${1:-}" in --no-test|-n) TEST=0;; esac
	[ -n "$NEW" ] || { echo 'ERROR: 用法: ruijie-password set <新密码> [--no-test]'; exit 1; }

	OLD="$(get password_payload)"
	if [ "$OLD" = "$NEW" ]; then
		echo '新密码与当前密码相同，未做改动'
		exit 0
	fi

	uci set "$CFG.password_prev=$OLD"
	uci set "$CFG.password_payload=$NEW"
	uci commit ruijie
	logger -t ruijie-password 'password changed; the previous value was kept for rollback'
	printf '新密码   : %s\n' "$(mask "$NEW")"
	printf '回退点   : %s\n' "$(mask "$OLD")"

	if [ "$TEST" = 0 ]; then
		echo '已跳过在线验证。若登录失败: /usr/libexec/ruijie-password revert'
		exit 0
	fi
	if ! wan_ready; then
		echo 'WAN 当前没有 IPv4，跳过在线验证。恢复后请执行: /usr/libexec/ruijie-password check'
		exit 0
	fi

	echo '正在用新密码做一次真实登录验证（会短暂断线）...'
	pause_daemon
	/usr/libexec/ruijie-auth reauth >/dev/null 2>&1
	RC=$?

	if [ "$RC" -eq 0 ]; then
		resume_daemon
		echo '验证通过：新密码可以登录。回退点仍保留在 password_prev。'
		exit 0
	fi
	if [ "$RC" -eq 75 ]; then
		resume_daemon
		echo '另一个认证操作正在运行，没验证成。新密码已写入但未验证。'
		echo '稍后请执行: /usr/libexec/ruijie-password check'
		exit 0
	fi

	REASON="$(last_reason)"
	explain_failure "$REASON"
	if [ "$REASON" = network ]; then
		resume_daemon
		echo '保持新密码不变。'
		exit 0
	fi

	uci set "$CFG.password_payload=$OLD"
	uci set "$CFG.password_prev=$NEW"
	uci commit ruijie
	logger -t ruijie-password 'new password was rejected; restored the previous one'
	echo '已自动回退到原密码。'
	# The daemon is still paused, so this login cannot collide with it.
	/usr/libexec/ruijie-auth login >/dev/null 2>&1 || true
	resume_daemon
	exit 1
	;;

check)
	if ! wan_ready; then
		echo 'ERROR: WAN 没有 IPv4，无法验证'
		exit 1
	fi
	echo '正在用当前密码做一次真实登录验证（会短暂断线）...'
	pause_daemon
	/usr/libexec/ruijie-auth reauth >/dev/null 2>&1
	RC=$?
	resume_daemon
	if [ "$RC" -eq 0 ]; then
		echo '验证通过：当前密码可以登录'
		exit 0
	fi
	if [ "$RC" -eq 75 ]; then
		echo '另一个认证操作正在运行，没验证成，请稍后再试'
		exit 75
	fi
	explain_failure "$(last_reason)"
	[ -n "$(get password_prev)" ] && echo '有一个回退点可用: /usr/libexec/ruijie-password revert'
	exit 1
	;;

revert)
	cur="$(get password_payload)"
	prev="$(get password_prev)"
	if [ -z "$prev" ]; then
		echo 'ERROR: 没有回退点（password_prev 为空）'
		exit 1
	fi
	uci set "$CFG.password_payload=$prev"
	uci set "$CFG.password_prev=$cur"
	uci commit ruijie
	logger -t ruijie-password 'password rolled back to the previous value'
	printf '已换回   : %s\n' "$(mask "$prev")"
	printf '回退点   : %s（再执行一次 revert 可换回去）\n' "$(mask "$cur")"
	;;

drop)
	uci -q delete "$CFG.password_prev"
	uci commit ruijie
	logger -t ruijie-password 'password rollback point discarded'
	echo '回退点已删除'
	;;

*)
	echo '用法: ruijie-password {status|set <新密码> [--no-test]|check|revert|drop}'
	exit 1
	;;
esac
