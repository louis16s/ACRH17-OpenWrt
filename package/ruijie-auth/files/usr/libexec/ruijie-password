#!/bin/sh
# Change the Ruijie account password with a one-command rollback.
#
# A wrong password takes the campus link down and the daemon cannot recover by
# retrying, so every change keeps the value it replaced in password_prev and
# the replacement is proven by a real portal round trip before it is kept.
# When that round trip is rejected -- and only then -- the old password goes
# back automatically. password_prev moves with every set, so the value the
# router shipped with is anchored separately in password_original, written once
# and never moved, and reachable with revert --original.
#
#   ruijie-password status            what is stored, masked
#   ruijie-password set <password>    back up, switch, verify, auto-revert
#   ruijie-password set <password> --no-test
#   ruijie-password check             verify the current password with a login
#   ruijie-password revert            put the backed-up password back
#   ruijie-password revert --original put the password the router shipped with back
#   ruijie-password drop              discard the rollback point
#
# Exit status, so a caller can tell a proven password from a written one:
#   0  the portal accepted the value that is now stored
#   1  the portal rejected it and the previous value was put back
#   2  the value was stored but nothing proved it either way -- no test was
#      asked for, the WAN had no address, or the answer said nothing about the
#      credential. Reporting this as success is how a password nobody has
#      verified comes to look verified.
#   75 check only: another authentication action held the lock
#
# Passwords never reach syslog; only the fact that one changed does.
umask 077
CFG="ruijie.main"
LAST="/tmp/ruijie-auth.last"
get() { uci -q get "$CFG.$1"; }

# Enough to tell two known passwords apart in a terminal without printing one.
mask() {
	[ -n "$1" ] || { printf '(未设置)'; return; }
	# tail -c 2 takes two bytes, which is not two characters when the value has
	# any non-ASCII in it: the last two bytes of a longer character are not a
	# character, they are half of one, and printing them emits a byte sequence
	# the terminal cannot decode. Byte counts are equally misleading ("12 位" for
	# four Chinese characters), so a value that is not plain ASCII gets a
	# description that is true instead of a tail that is not.
	if [ -n "$(printf '%s' "$1" | LC_ALL=C tr -d '\000-\177')" ]; then
		# wc -c, not ${#1}: a shell with a multibyte ctype counts characters, so
		# ${#1} reports 4 for four Chinese characters while the unit says 字节.
		# BusyBox counts bytes either way; this keeps the two honest together.
		printf '含非 ASCII 字符（%s 字节）' "$(printf '%s' "$1" | wc -c | tr -d '[:space:]')"
		return
	fi
	printf '%s 位，末两位 %s' "${#1}" "$(printf '%s' "$1" | tail -c 2)"
}

wan_ready() {
	wan="$(get wan_interface)"
	case "$wan" in ''|*[!A-Za-z0-9_-]*) wan=wan;; esac
	status_json="$(ubus call "network.interface.$wan" status 2>/dev/null)" || return 1
	up="$(printf '%s' "$status_json" | jsonfilter -e '@.up' 2>/dev/null)"
	case "$up" in 1|true) ;; *) return 1;; esac
	ipv4="$(printf '%s' "$status_json" | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)"
	case "$ipv4" in ''|0.0.0.0) return 1;; esac
	return 0
}

daemon_was_running=0

# The daemon re-authenticates on its own schedule and takes the authentication
# lock while it does. Left running it would race the probe, turning a busy lock
# into a "75" that says nothing about the password. Stop it for the round trip
# and start it again once the winning password is the one in the config.
pause_daemon() {
	daemon_was_running=0
	if /etc/init.d/ruijie-auth running >/dev/null 2>&1; then
		daemon_was_running=1
		/etc/init.d/ruijie-auth stop >/dev/null 2>&1
	fi
}

# Idempotent: both the explicit calls below and the EXIT trap run this, and the
# first one to run clears the flag so the second is a no-op.
resume_daemon() {
	[ "$daemon_was_running" = 1 ] || return 0
	daemon_was_running=0
	/etc/init.d/ruijie-auth start >/dev/null 2>&1
	return 0
}

# The verification window stops the daemon and then spends up to a minute on
# portal round trips. An interrupt inside that window used to leave it stopped
# for good: procd respawns a process that crashed, not an instance that was
# stopped on purpose, so the campus link stayed down until someone started the
# service by hand. The signal traps only make the interrupt leave by the front
# door; the EXIT trap is what actually restarts the daemon, and it fires on
# every path, including a normal return.
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP
trap 'resume_daemon' EXIT

# Why the last portal round trip ended the way it did.
#
# Only the portal answering in its own format and turning the login down is
# evidence about the password. Everything else is an absence of evidence and
# must not be read as "the password is wrong": a request that never reached the
# portal, and an answer we could not parse (a redirect, an HTML error page, a
# stale query_string after the WAN address changed), both say nothing about the
# credential, and treating them as rejection rolls back a good password during
# an outage. The two are matched by name rather than by a catch-all so a new
# failure string cannot silently land in the rejection bucket.
last_reason() {
	case "$(cat "$LAST" 2>/dev/null)" in
	login:*'portal rejected request'*) printf 'rejected';;
	login:*'HTTP or network error'*)   printf 'network';;
	*)                                 printf 'unknown';;
	esac
}

explain_failure() {
	case "$1" in
	network)
		echo '认证请求没能送达门户（网络问题），这不代表新密码是错的。'
		echo '要立刻退回旧密码: /usr/libexec/ruijie-password revert'
		;;
	rejected)
		echo '门户拒绝了这次登录，最可能是密码不对。'
		;;
	*)
		echo '未能确认登录结果，这不代表密码是错的。'
		# The recorded line distinguishes the two ways this happens: the portal
		# answered something that was not its own format, or no request ever
		# left the router (no WAN address, server or userId not configured).
		recorded="$(cat "$LAST" 2>/dev/null)"
		[ -n "$recorded" ] && printf '本次记录: %s\n' "$recorded"
		# ${LAST}, not $LAST: a bare $VAR followed by a non-ASCII byte lets a
		# shell with a multibyte ctype absorb that byte into the variable name,
		# which is how this line lost its first character and printed an empty
		# path. It bit macOS, whose default locale is UTF-8; it cannot bite the
		# router, where musl's isalpha is ASCII-only whatever the locale says.
		echo "详情见 ${LAST}；网络恢复后可再执行: /usr/libexec/ruijie-password check"
		;;
	esac
}

CMD="${1:-}"
[ $# -gt 0 ] && shift

case "$CMD" in
status)
	cur="$(get password_payload)"
	prev="$(get password_prev)"
	printf '当前密码 : %s\n' "$(mask "$cur")"
	printf '回退点   : %s\n' "$(mask "$prev")"
	if [ -n "$prev" ]; then
		echo '可用 /usr/libexec/ruijie-password revert 换回回退点里的那个'
	else
		echo '没有回退点：保存新密码时会自动把旧密码存进去'
	fi
	# Only meaningful once a password has been changed at least once; before
	# that there is nothing to anchor to.
	orig="$(get password_original)"
	if [ -n "$orig" ]; then
		printf '最初密码 : %s\n' "$(mask "$orig")"
		echo '可用 /usr/libexec/ruijie-password revert --original 直接换回它'
	fi
	;;

set)
	NEW="${1:-}"
	[ $# -gt 0 ] && shift
	TEST=1
	case "${1:-}" in --no-test|-n) TEST=0;; esac
	case "$NEW" in
	'')  echo 'ERROR: 用法: ruijie-password set <新密码> [--no-test]'; exit 1;;
	# `set --no-test` with the flag first and no password would otherwise sail
	# through the non-empty check and store the literal string "--no-test".
	-*)  echo 'ERROR: 密码不能以 - 开头。用法: ruijie-password set <新密码> [--no-test]'; exit 1;;
	esac

	OLD="$(get password_payload)"
	if [ "$OLD" = "$NEW" ]; then
		echo '新密码与当前密码相同，未做改动'
		exit 0
	fi

	# password_original is written once, the first time a password is ever
	# changed, and nothing else moves it. password_prev is overwritten by every
	# set, so after a second change the value the router shipped with is no
	# longer reachable through it -- and a set during an outage, which exits
	# without verifying anything, is exactly when people try again.
	#
	# The test is whether the option has ever been written, not whether its value
	# is non-empty. The shipped payload is empty, so an emptiness test writes the
	# anchor one change too late -- onto a value that had itself just been
	# replaced, and in the worst case onto one the portal had already rejected.
	# `uci -q get` exits 1 for an option that does not exist and 0 for one that
	# exists with an empty value, which is exactly the distinction wanted here.
	if ! get password_original >/dev/null 2>&1; then
		uci set "$CFG.password_original=$OLD"
	fi
	uci set "$CFG.password_prev=$OLD"
	uci set "$CFG.password_payload=$NEW"
	uci commit ruijie
	logger -t ruijie-password 'password changed; the previous value was kept for rollback'
	printf '新密码   : %s\n' "$(mask "$NEW")"
	printf '回退点   : %s\n' "$(mask "$OLD")"

	if [ "$TEST" = 0 ]; then
		echo '已跳过在线验证（退出码 2 表示已写入但未验证，不是失败）。'
		echo '若登录失败: /usr/libexec/ruijie-password revert'
		exit 2
	fi
	if ! wan_ready; then
		echo 'WAN 当前没有 IPv4，跳过在线验证（退出码 2 表示已写入但未验证）。'
		echo '恢复后请执行: /usr/libexec/ruijie-password check'
		exit 2
	fi

	echo '正在用新密码做一次真实登录验证（会短暂断线）...'
	pause_daemon
	# The verdict has to come from this attempt. portal_request has paths that
	# return without writing the file at all, and the previous run's answer would
	# then be read as this run's: a stale "portal rejected request" rolls back a
	# password that was never actually put to the portal, and tells the user the
	# portal refused it. The daemon is stopped here, so nothing else is writing.
	rm -f "$LAST"
	/usr/libexec/ruijie-auth reauth >/dev/null 2>&1
	RC=$?

	if [ "$RC" -eq 0 ]; then
		resume_daemon
		echo '验证通过：新密码可以登录。回退点仍保留在 password_prev。'
		exit 0
	fi
	if [ "$RC" -eq 75 ]; then
		resume_daemon
		echo '另一个认证操作正在运行，没验证成。新密码已写入但未验证。'
		echo '稍后请执行: /usr/libexec/ruijie-password check'
		exit 2
	fi

	REASON="$(last_reason)"
	explain_failure "$REASON"
	# Roll back only on a real rejection. network and unknown both mean "this
	# attempt produced no evidence about the password", and swapping the
	# password on no evidence is how a good one gets thrown away. The caller can
	# still tell the two apart from the exit status: only a real rejection exits 1.
	if [ "$REASON" != rejected ]; then
		resume_daemon
		echo '保持新密码不变。'
		exit 2
	fi

	uci set "$CFG.password_payload=$OLD"
	uci set "$CFG.password_prev=$NEW"
	uci commit ruijie
	logger -t ruijie-password 'new password was rejected; restored the previous one'
	echo '已自动回退到原密码。'
	# The daemon is still paused, so this login cannot collide with it.
	/usr/libexec/ruijie-auth login >/dev/null 2>&1 || true
	resume_daemon
	exit 1
	;;

check)
	if ! wan_ready; then
		echo 'ERROR: WAN 没有 IPv4，无法验证'
		exit 1
	fi
	echo '正在用当前密码做一次真实登录验证（会短暂断线）...'
	pause_daemon
	rm -f "$LAST"
	/usr/libexec/ruijie-auth reauth >/dev/null 2>&1
	RC=$?
	# Read the verdict before the daemon is running again. It writes this file on
	# its own schedule, so reading afterwards could hand the user the explanation
	# for a request the daemon made rather than the one just made here.
	REASON="$(last_reason)"
	resume_daemon
	if [ "$RC" -eq 0 ]; then
		echo '验证通过：当前密码可以登录'
		exit 0
	fi
	if [ "$RC" -eq 75 ]; then
		echo '另一个认证操作正在运行，没验证成，请稍后再试'
		exit 75
	fi
	explain_failure "$REASON"
	[ -n "$(get password_prev)" ] && echo '有一个回退点可用: /usr/libexec/ruijie-password revert'
	# 1 means the portal turned this password down. Anything else is an answer
	# that said nothing about the credential, which is a different outcome and
	# must not be reported to a caller as "this password is wrong".
	[ "$REASON" = rejected ] && exit 1
	exit 2
	;;

revert)
	# Only --original is accepted. A near miss used to fall through to the plain
	# revert, which swaps in the *previous* password while the user believes they
	# asked for the original one -- and since both paths print nothing but a
	# mask, nothing on screen showed which of the two had happened.
	ORIGINAL=0
	case "${1:-}" in
	'') ;;
	--original) ORIGINAL=1;;
	*) echo 'ERROR: 用法: ruijie-password revert [--original]'; exit 1;;
	esac
	cur="$(get password_payload)"
	if [ "$ORIGINAL" = 1 ]; then
		if ! get password_original >/dev/null 2>&1; then
			echo 'ERROR: 没有记录最初密码（还没换过密码）'
			exit 1
		fi
		orig="$(get password_original)"
		if [ -z "$orig" ]; then
			echo 'ERROR: 最初密码是空的（这台设备出厂时没有配置过密码），没有可换回的值'
			exit 1
		fi
		if [ "$cur" = "$orig" ]; then
			echo '当前密码已经是最初那个了'
			exit 0
		fi
		# The anchor never moves. The value being replaced goes into the
		# rollback point instead, so a plain revert still brings it back -- but
		# only when there is a value: an empty current password is not a
		# password, and storing it would discard the rollback point instead of
		# moving it.
		if [ -n "$cur" ]; then
			uci set "$CFG.password_prev=$cur"
		fi
		uci set "$CFG.password_payload=$orig"
		uci commit ruijie
		logger -t ruijie-password 'password rolled back to the original value'
		printf '已换回最初: %s\n' "$(mask "$orig")"
		# Read the rollback point back rather than assume it: the guard above
		# leaves it untouched when the current value was empty.
		printf '回退点   : %s（再执行 revert 可换回来）\n' "$(mask "$(get password_prev)")"
		exit 0
	fi
	prev="$(get password_prev)"
	if [ -z "$prev" ]; then
		echo 'ERROR: 没有回退点（password_prev 为空）'
		exit 1
	fi
	uci set "$CFG.password_payload=$prev"
	# Same guard as above: swapping an empty value into the rollback point would
	# discard the only password still known to work.
	if [ -n "$cur" ]; then
		uci set "$CFG.password_prev=$cur"
	fi
	uci commit ruijie
	logger -t ruijie-password 'password rolled back to the previous value'
	printf '已换回   : %s\n' "$(mask "$prev")"
	printf '回退点   : %s（再执行一次 revert 可换回去）\n' "$(mask "$(get password_prev)")"
	;;

drop)
	uci -q delete "$CFG.password_prev"
	uci commit ruijie
	logger -t ruijie-password 'password rollback point discarded'
	echo '回退点已删除'
	;;

*)
	echo '用法: ruijie-password {status|set <新密码> [--no-test]|check|revert [--original]|drop}'
	exit 1
	;;
esac
