CONFIG_TARGET_ipq40xx=y
CONFIG_TARGET_ipq40xx_generic=y
CONFIG_TARGET_ipq40xx_generic_DEVICE_asus_rt-ac42u=y

CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
# ImmortalWrt enables the OpenSSL LuCI collection by default in some
# profiles.  luci-ssl already selects the mbedTLS ustream backend; selecting
# both collections installs two providers of the same libustream-ssl.so and
# makes package/install fail with a file clash.
# CONFIG_PACKAGE_luci-ssl-openssl is not set
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-watchcat=y
CONFIG_PACKAGE_watchcat=y
CONFIG_PACKAGE_luci-app-commands=y
CONFIG_PACKAGE_irqbalance=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_OFFLOADING=y
# These vendor-specific shortcut/fullcone modules are not available in the
# pinned OpenWrt 24.10 package feeds.
# CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_SHORTCUT_FE is not set
# CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_SHORTCUT_FE_CM is not set
# CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_SHORTCUT_FE_DRV is not set
# CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_NFT_FULLCONE is not set

CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_tcpdump-mini=y

# UA3F + LuCI
CONFIG_PACKAGE_ua3f=y
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_kmod-nft-tproxy=y

# Multi-WAN
# CONFIG_PACKAGE_mwan3 is not set
# CONFIG_PACKAGE_luci-app-mwan3 is not set
# Single-WAN uses firewall4/nftables; legacy iptables are not needed.
# CONFIG_PACKAGE_iptables-zz-legacy is not set
# CONFIG_PACKAGE_ip6tables-zz-legacy is not set

# USB base
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-net=y

# Android tethering / ZTE F50 compatibility
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_umbim=y
CONFIG_PACKAGE_luci-proto-mbim=y

# USB printer server
CONFIG_PACKAGE_kmod-usb-printer=y
CONFIG_PACKAGE_p910nd=y
CONFIG_PACKAGE_luci-app-p910nd=y

# BBR + RAM optimization
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_ruijie-auth=y
CONFIG_PACKAGE_luci-compat=y

CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_PACKAGE_kmod-sched=y
CONFIG_PACKAGE_jsonfilter=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_LUCI_LANG_zh_Hans=y

# Time/DNS services
CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_luci-app-smartdns=y

# ccache is gated by the OpenWrt DEVEL option; keep it enabled so the
# Actions .ccache cache is actually used by host and target compilers.
CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_IB=y
CONFIG_IB_STANDALONE=y
